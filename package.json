{
  "name": "gitwarren",
  "productName": "GitWarren",
  "version": "0.1.0",
  "description": "Desktop app for doing local-only code reviews",
  "author": {
    "name": "Klarluft B.V.",
    "email": "contact@klarluft.com",
    "url": "https://klarluft.com"
  },
  "contributors": [
    {
      "name": "Michal Wrzosek",
      "email": "michal@wrzosek.pl",
      "url": "https://github.com/michal-wrzosek"
    }
  ],
  "license": "GPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/klarluft/gitwarren-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarluft/gitwarren-app.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && npm run build:mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/run-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "mcp:dev": "tsx src/mcp/server.ts",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.38.0",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.6",
    "zod": "^4.5.4"
  }
}
